<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.slotwise</groupId>
        <artifactId>slotwise-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>slotwise-observability</artifactId>
    <packaging>jar</packaging>

    <name>slotwise-observability</name>
    <description>Spring Boot's OpenTelemetry starter (traces, logs, metrics over OTLP) and structured ECS logs shared by the services: dependencies plus default properties</description>

    <dependencies>
        <!-- Spring Boot's own OpenTelemetry starter, as the reference documentation recommends (no Java agent): Micrometer Tracing
             with the OpenTelemetry bridge, the OTLP exporters and the Micrometer OTLP registry, all configured with
             management.opentelemetry.* / management.otlp.* properties and versions managed by the Boot BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <!-- Logs: Logback events -> OpenTelemetry log records (the documented OpenTelemetryAppender; Boot's docs give no
             coordinates). 2.28.1-alpha is the instrumentation release built against OpenTelemetry SDK 1.62.0, the one
             Boot 4.1.1 manages. -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
            <version>2.28.1-alpha</version>
        </dependency>
        <!-- JDBC is not instrumented by Boot itself; its observability docs point to the Datasource Micrometer project. The 2.x
             line targets Spring Boot 4. It wraps DataSource beans and emits `query` (and connection/result-set) observations,
             which become spans through the tracing bridge above. See booking-service for the routing DataSource exclusion. -->
        <dependency>
            <groupId>net.ttddyy.observation</groupId>
            <artifactId>datasource-micrometer-spring-boot</artifactId>
            <version>2.3.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
